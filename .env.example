# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Email - Autenticação por OTP e Notificações (Brevo, Resend ou SMTP)
# ==============================================================================
# OPÇÃO A: Brevo / Sendinblue (Recomendado - 300 e-mails/dia grátis sem bloqueios e sem restrição de destinatários)
# Obtenha a chave em https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM="Arquivo Central SBIDM UA" <arquivo.SBIDMUA.noreply@gmail.com>

# OPÇÃO B: Resend (3.000 emails/mês grátis, requer validação de domínio para envio a terceiros)
RESEND_API_KEY=re_123456789_abcdef
RESEND_FROM="Arquivo Central SBIDM UA" <onboarding@resend.dev>

# OPÇÃO C: SMTP Clássico (ex: Gmail, Brevo SMTP Relay smtp-relay.brevo.com:587 ou UA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=just4subsc@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Arquivo Central SBIDM UA" <just4subsc@gmail.com>

# Endereço institucional a receber cópia (CC) de notificações operacionais (os códigos OTP são estritamente individuais)
SMTP_CC=arquivo@ua.pt

# Base de Dados Cloud Serverless - Turso (libSQL / SQLite)
# Opcional: Para ambientes serverless na cloud (ex: Vercel) sem sistema de ficheiros persistente
TURSO_DATABASE_URL=libsql://arquidocs-sua-org.turso.io
TURSO_AUTH_TOKEN=seu-token-autenticacao-turso
